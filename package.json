{
  "name": "agent-zero",
  "version": "1.0.0",
  "description": "Agent-less Windows System Vulnerability & Network Scanner",
  "main": "electron/main.js",
  "author": "AYUSH-KAVYA",
  "license": "MIT",
  "homepage": "https://github.com/AYUSH-KAVYA/agentZero",
  "repository": {
    "type": "git",
    "url": "https://github.com/AYUSH-KAVYA/agentZero.git"
  },
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "build:python": "cd python && pyinstaller --onefile --clean --name scanner --add-data \"data;data\" --add-data \"report/templates;report/templates\" main.py",
    "build:electron": "npm run build && electron-builder --win",
    "preview": "vite preview",
    "lint": "eslint src/ --ext .js,.jsx",
    "format": "prettier --write \"src/**/*.{js,jsx,css,md}\""
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "recharts": "^2.12.7",
    "lucide-react": "^0.441.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.35.0",
    "postcss": "^8.4.41",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.10",
    "vite": "^5.4.2",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.agentzero.scanner",
    "productName": "AgentZero",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "extraResources": [
      {
        "from": "python/dist/scanner.exe",
        "to": "scanner.exe"
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*"
    ]
  }
}
